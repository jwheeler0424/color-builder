{
  "name": "color-builder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run generate-routes && PORT=5177 bun --hot src/index.ts",
    "build": "bun run generate-routes && bun build.ts",
    "start": "bun run generate-routes && NODE_ENV=production bun src/index.ts",
    "preview": "bun run start",
    "check-types": "bun run generate-routes && tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --check",
    "format:fix": "oxfmt --write .",
    "check": "oxfmt --check . && oxlint --fix",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "build:colors": "bun scripts/build-csv-color-db.ts",
    "build:colors:legacy": "bun scripts/build-color-db.ts",
    "generate-routes": "bun --preload ./node_modules/@tanstack/router-core/dist/cjs/router.cjs ./node_modules/@tanstack/router-cli/bin/tsr.cjs generate",
    "watch-routes": "bun --preload ./node_modules/@tanstack/router-core/dist/cjs/router.cjs ./node_modules/@tanstack/router-cli/bin/tsr.cjs watch"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/syne": "^5.3.0",
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/quicksand": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/charts": "0.18.0",
    "@tanstack/pacer": "^0.23.0",
    "@tanstack/react-devtools": "^0.10.13",
    "@tanstack/react-pacer": "^0.24.0",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-query-devtools": "^5.104.1",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-router-devtools": "^1.167.2",
    "bun-plugin-tailwind": "^0.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "color-name": "^2.1.1",
    "d3-shape": "^3.2.0",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "html2canvas": "^1.4.1",
    "immer": "^11.1.21",
    "lcms-wasm": "^1.0.5",
    "lucide-react": "^1.50.0",
    "react": "^19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "react-resizable-panels": "^4.14.2",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/source-code-pro": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@happy-dom/global-registrator": "^20.14.5",
    "@tanstack/react-pacer-devtools": "^0.9.0",
    "@tanstack/router-cli": "^1.167.40",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "^1.4.2",
    "@types/color-name": "^2.0.0",
    "@types/d3-shape": "^3.1.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "bun": "^1.4.2",
    "csv-parse": "^7.0.3",
    "csv-stringify": "^6.9.0",
    "happy-dom": "^20.14.5",
    "hyparquet": "^1.31.2",
    "hyparquet-compressors": "^1.1.2",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2"
  }
}
